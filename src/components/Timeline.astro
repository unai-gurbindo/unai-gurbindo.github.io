---
interface TimelineItem {
  period: string;
  title: string;
  institution: string;
  location: string;
  description: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<div class="space-y-5">
  {
    items.map((item) => (
      <article class="relative rounded-3xl border border-[var(--border)] bg-white/55 p-6">
        <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
          <div>
            <h3 class="text-xl font-semibold text-[var(--text)]">
              {item.title}
            </h3>
            <p class="mt-1 text-sm font-medium text-[var(--blue)]">
              {item.institution}
            </p>
          </div>
          <div class="text-left md:text-right">
            <p class="text-sm font-semibold text-[var(--text)]">
              {item.period}
            </p>
            <p class="text-sm text-[var(--muted)]">
              {item.location}
            </p>
          </div>
        </div>

        <p class="mt-4 leading-7 text-[var(--muted)]">
          {item.description}
        </p>
      </article>
    ))
  }
</div>