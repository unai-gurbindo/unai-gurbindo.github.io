---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Writing — Coming soon | Unai Gurbindo Gonzalez"
  description="Essays, research notes and reflections by Unai Gurbindo Gonzalez. Coming soon."
>
  <section class="writing-coming-soon container-page">
    <div class="coming-soon-copy">
      <p class="eyebrow">Writing</p>
      <h1>Essays and research notes</h1>
      <p class="status">Coming soon.</p>
      <p class="description">
        I am preparing a collection of research notes, technical reflections and longer-form writing on uncertainty quantification, trustworthy AI and responsible deployment.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .writing-coming-soon {
    min-height: calc(100vh - 210px);
    display: flex;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 96px;
  }

  .coming-soon-copy {
    max-width: 720px;
  }

  .coming-soon-copy h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .status {
    margin: 18px 0 0;
    color: var(--navy);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .description {
    max-width: 620px;
    margin: 13px 0 0;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  @media (max-width: 700px) {
    .writing-coming-soon {
      min-height: calc(100vh - 180px);
      align-items: flex-start;
      padding-top: 52px;
      padding-bottom: 72px;
    }
  }
</style>
